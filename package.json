{
  "name": "oiblog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run generate && astro build && npm run og && npm run pagefind",
    "generate": "npm run generate:summaries && npm run generate:similarities",
    "generate:summaries": "node scripts/generate-summaries.mjs",
    "generate:similarities": "node scripts/generate-similarities.mjs",
    "editor": "vite build --config vite.editor.config.mjs",
    "prebuild": "test -f public/editor/editor.js || npm run editor",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "og": "node scripts/gen-og.mjs",
    "pagefind": "pagefind --site dist",
    "check:links": "node scripts/check-links.mjs",
    "shots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource/maple-mono": "^5.3.0",
    "@jannchie/pixi-live2d-display": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "astro-icon": "^1.2.0",
    "codemirror": "^6.0.2",
    "katex": "^0.19.0",
    "marked": "^18.1.2",
    "pagefind": "^1.5.2",
    "pixi.js": "^8.22.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "playwright": "^1.64.1",
    "satori": "^0.63.2",
    "typescript": "^5.7.0"
  }
}
