---
/**
 * 引导页 —— snow 式中央白卡 + koharu 式插画头图
 *
 * 结构：
 *   全屏插画头图（HeroBanner）
 *     → 波浪分割
 *     → 中央白卡（头像 / 昵称 / 签名 / 社交按钮）
 *     → 进入博客的提示
 */
import { site, social, socialIcons, socialKeys } from '@/config';
import WaveDivider from './WaveDivider.astro';

interface Props {
  /** 头图背景图；默认主页主图 */
  background?: string;
  /** 头像 */
  avatar?: string;
  /** 是否在卡片下方显示「进入博客」按钮 */
  showEnter?: boolean;
}

const { background = '/img/bg/hero-main.jpg', avatar = site.avatar, showEnter = true } = Astro.props;

const heroBg = background;
const socialList = socialKeys.map((k) => ({ key: k, ...social[k], ...socialIcons[k] }));
---

<section class="intro-hero">
  <div class="hero-bg" style={`background-image:url('${heroBg}')`}></div>

  <div class="hero-overlay"></div>

  <div class="intro-card">
    <img class="intro-avatar" src={avatar} alt={`${site.author} 的头像`} loading="eager" />

    <h1 class="intro-name">{site.title}</h1>
    <p class="intro-tagline">{site.description}</p>

    <div class="intro-socials">
      {
        socialList.map((s) => (
          <a
            href={s.url}
            class="social-logo"
            style={`--sc:${s.color}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            title={s.label}
          >
            <span class="sl-icon" set:html={s.svg} />
          </a>
        ))
      }
    </div>

    {
      showEnter && (
        <a href="/blog/" class="enter-btn">
          进入博客
          <span class="enter-arrow" aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</section>

<WaveDivider color="var(--t-bg)" color2="var(--t-bg-soft)" color3="var(--t-bg-card)" />

<style>
  .intro-hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-size: cover;
    background-position: center;
    transform: scale(1.03);
    animation: heroZoom 24s var(--t-ease) infinite alternate;
  }

  @keyframes heroZoom {
    from { transform: scale(1.03); }
    to { transform: scale(1.12); }
  }

  /* 底部渐隐，让波浪衔接自然 */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(62% 52% at 50% 44%, rgba(24, 10, 22, 0.3), rgba(0, 0, 0, 0) 72%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.18) 100%);
  }

  .enter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.8rem;
    padding: 0.7em 1.9em;
    font-size: 1.35rem;
    font-weight: 500;
    color: #fff;
    background: linear-gradient(135deg, var(--t-gradient-from), var(--t-gradient-to));
    border-radius: var(--t-radius-full);
    box-shadow: var(--t-shadow-button);
    transition: transform 0.28s var(--t-ease), filter 0.28s;
  }
  .enter-btn:hover {
    color: #fff;
    transform: translateY(-3px);
    filter: brightness(1.08);
  }
  .enter-arrow {
    transition: transform 0.28s var(--t-ease);
  }
  .enter-btn:hover .enter-arrow { transform: translateX(4px); }

  /* 社交平台 logo 图标 */
  .intro-socials { display: flex; gap: 0.9rem; justify-content: center; }
  .social-logo {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    color: var(--sc, var(--t-primary));
    background: color-mix(in srgb, var(--t-bg-card) 80%, transparent);
    border: 1px solid var(--t-line);
    transition: all 0.28s var(--t-ease);
    backdrop-filter: blur(6px);
  }
  .social-logo:hover {
    color: #fff;
    background: var(--sc, var(--t-primary));
    border-color: transparent;
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 10px 24px -10px color-mix(in srgb, var(--sc, var(--t-primary)) 60%, transparent);
  }
  .sl-icon { display: grid; place-items: center; width: 2rem; height: 2rem; }
  .sl-icon :global(svg) { width: 100%; height: 100%; }

  @media (max-width: 700px) {
    .intro-hero { min-height: 78vh; }
    .social-logo { width: 3.4rem; height: 3.4rem; }
  }
</style>
