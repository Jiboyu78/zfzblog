---
/**
 * 引导页 —— snow 式中央白卡 + koharu 式插画头图
 *
 * 结构：
 *   全屏插画头图（HeroBanner）
 *     → 波浪分割
 *     → 中央白卡（头像 / 昵称 / 签名 / 社交按钮）
 *     → 进入博客的提示
 */
import { site, social } from '@/config';
import { pickRandomImages } from '@/lib/gallery';
import WaveDivider from './WaveDivider.astro';

interface Props {
  /** 头图背景图；不传则从图库随机取 */
  background?: string;
  /** 头像 */
  avatar?: string;
  /** 是否在卡片下方显示「进入博客」按钮 */
  showEnter?: boolean;
}

const { background, avatar = site.avatar, showEnter = true } = Astro.props;

// 从图库随机取一张作为头图；图库为空时回落到内置 SVG
const galleryImages = pickRandomImages(1);
const heroBg = background ?? galleryImages[0] ?? '/img/bg/hero.svg';

const socialList = Object.entries(social);
---

<section class="intro-hero">
  <div class="hero-bg" style={`background-image:url('${heroBg}')`}></div>

  <div class="hero-overlay"></div>

  <div class="intro-card">
    <img class="intro-avatar" src={avatar} alt={`${site.author} 的头像`} loading="eager" />

    <h1 class="intro-name">{site.title}</h1>
    <p class="intro-tagline">{site.description}</p>

    <div class="intro-socials">
      {
        socialList.map(([key, s], i) => (
          <a
            href={s.url}
            class={`social-btn ${i === 0 ? 'is-primary' : ''}`}
            target={s.url.startsWith('http') ? '_blank' : undefined}
            rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {s.label}
          </a>
        ))
      }
    </div>

    {
      showEnter && (
        <a href="/blog/" class="enter-btn">
          进入博客
          <span class="enter-arrow" aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</section>

<WaveDivider color="var(--t-bg)" color2="var(--t-bg-soft)" color3="var(--t-bg-card)" />

<style>
  .intro-hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-size: cover;
    background-position: center;
    transform: scale(1.03);
    animation: heroZoom 24s var(--t-ease) infinite alternate;
  }

  @keyframes heroZoom {
    from { transform: scale(1.03); }
    to { transform: scale(1.12); }
  }

  /* 底部渐隐，让波浪衔接自然 */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(62% 52% at 50% 44%, rgba(24, 10, 22, 0.3), rgba(0, 0, 0, 0) 72%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.18) 100%);
  }

  .enter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.8rem;
    padding: 0.7em 1.9em;
    font-size: 1.35rem;
    font-weight: 500;
    color: #fff;
    background: linear-gradient(135deg, var(--t-gradient-from), var(--t-gradient-to));
    border-radius: var(--t-radius-full);
    box-shadow: var(--t-shadow-button);
    transition: transform 0.28s var(--t-ease), filter 0.28s;
  }
  .enter-btn:hover {
    color: #fff;
    transform: translateY(-3px);
    filter: brightness(1.08);
  }
  .enter-arrow {
    transition: transform 0.28s var(--t-ease);
  }
  .enter-btn:hover .enter-arrow { transform: translateX(4px); }

  @media (max-width: 700px) {
    .intro-hero { min-height: 78vh; }
  }
</style>
