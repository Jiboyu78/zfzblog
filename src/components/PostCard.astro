---
/**
 * 文章卡片 —— koharu 式图文交替大卡
 * 左图右文 / 右图左文 交替（由列表中的序号决定）
 */
import type { CollectionEntry } from 'astro:content';
import { resolveCover } from '@/lib/gallery';

interface Props {
  post: CollectionEntry<'blog'>;
  /** 在列表中的序号，用于决定图文是否反转 */
  index?: number;
  /** 是否反转图文位置 */
  reversed?: boolean;
  /** 无图时是否显示占位 */
  compact?: boolean;
}

const { post, index = 0, reversed, compact = false } = Astro.props;

const d = post.data;
const cover = resolveCover(post.id, d.heroImage);
const isReversed = reversed ?? index % 2 === 1;

const dateStr = d.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});

/** 阅读时长估算 —— 中文按字数，西文按词数 */
const raw = post.body ?? '';
const cjk = (raw.match(/[一-龥]/g) || []).length;
const words = (raw.match(/[a-zA-Z0-9]+/g) || []).length;
const readTime = Math.max(1, Math.round(cjk / 400 + words / 200));
---

<article class={`post-card reveal ${isReversed ? 'is-reversed' : ''} ${compact ? 'is-compact' : ''} ${cover ? '' : 'no-cover'}`}>
  {
    cover ? (
      <a href={`/blog/${post.id}/`} class="pc-media" tabindex="-1" aria-hidden="true">
        <img src={cover} alt="" loading="lazy" decoding="async" />
      </a>
    ) : (
      <a href={`/blog/${post.id}/`} class="pc-media pc-media-ph" tabindex="-1" aria-hidden="true">
        <span class="ph-glyph">{d.category.slice(0, 2)}</span>
      </a>
    )
  }

  <div class="pc-body">
    <div class="pc-head">
      <a href={`/archive/${d.category}/`} class="pc-cat">{d.category}</a>
      {d.featured && <span class="pc-featured">✦ 推荐</span>}
      <span class="pc-date">{dateStr}</span>
    </div>

    <h3 class="pc-title">
      <a href={`/blog/${post.id}/`}>{d.title}</a>
    </h3>

    {d.description && <p class="pc-desc">{d.description}</p>}

    <div class="pc-foot">
      <div class="pc-tags">
        {d.tags.slice(0, 4).map((t) => <a href={`/tags/${t}/`} class="tag">#{t}</a>)}
      </div>
      <span class="pc-time">{readTime} 分钟阅读</span>
    </div>
  </div>
</article>

<style>
  .pc-media {
    position: relative;
    display: block;
    min-height: 15rem;
    height: 100%;
    border-radius: var(--t-radius-md);
    overflow: hidden;
    background: var(--t-bg-soft);
  }
  .pc-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--t-ease);
  }
  .post-card:hover .pc-media img { transform: scale(1.06); }

  /* 无封面时的渐变占位，保证图文网格不被破坏 */
  .pc-media-ph {
    display: grid;
    place-items: center;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--t-primary) 16%, var(--t-bg-soft)),
      color-mix(in srgb, var(--t-accent-alt) 16%, var(--t-bg-soft))
    );
  }
  .ph-glyph {
    position: relative;
    z-index: 1;
    font-size: 3.4rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--t-primary) 55%, transparent);
    letter-spacing: -1px;
    user-select: none;
  }

  .pc-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.7rem;
    font-size: 1.25rem;
    color: var(--t-ink-mute);
  }
  .pc-featured {
    color: var(--t-accent);
    font-weight: 700;
  }
  .pc-date { margin-left: auto; }

  .pc-title {
    font-size: 1.95rem;
    font-weight: 700;
    line-height: 1.45;
    margin: 0 0 0.6rem;
    color: var(--t-ink-strong);
    transition: color 0.25s;
  }
  .pc-title a { color: inherit; }
  .post-card:hover .pc-title { color: var(--t-primary); }

  .pc-desc {
    font-size: 1.32rem;
    line-height: 1.75;
    color: var(--t-ink-mute);
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pc-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--t-line);
  }
  .pc-tags { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .pc-time { font-size: 1.2rem; color: var(--t-ink-mute); white-space: nowrap; }

  /* 无图时的紧凑形态 */
  .is-compact .pc-body { grid-column: 1 / -1; }
</style>
