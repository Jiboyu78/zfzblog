---
import { site, nav, social, socialIcons, socialKeys, features } from '@/config';
import WaveDivider from './WaveDivider.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer no-print">
  <WaveDivider
    color="var(--t-bg)"
    color2="var(--t-bg-soft)"
    color3="var(--t-bg-card)"
    height={70}
  />

  <div class="footer-bg">
    <div class="container-page footer-inner">
      <div class="f-brand">
        <div class="f-name">{site.title}</div>
        <p class="f-desc">{site.description}</p>
        <div class="f-social">
          {
            socialKeys.map((key) => (
              <a
                href={social[key].url}
                class="f-social-btn"
                style={`--sc:${socialIcons[key].color}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social[key].label}
              >
                <span class="f-social-icon" set:html={socialIcons[key].svg} />
              </a>
            ))
          }
        </div>
      </div>

      <div class="f-col">
        <div class="f-title">导航</div>
        <ul class="f-list">
          {
            nav.map((n) => (
              <li>
                <a href={n.href}>{n.title}</a>
              </li>
            ))
          }
          {features.search && (
            <li>
              <a href="/search/">全文搜索</a>
            </li>
          )}
        </ul>
      </div>

      <div class="f-col">
        <div class="f-title">关于</div>
        <ul class="f-list">
          <li><a href="/about/">关于我</a></li>
          <li><a href="/friends/">友情链接</a></li>
          {
            socialKeys.map((key) => (
              <li>
                <a href={social[key].url} target="_blank" rel="noopener">
                  {social[key].label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="container-page f-bottom">
      <span>© {site.startYear} – {year} {site.author}</span>
      <span class="f-sep">·</span>
      <span>Powered by Astro</span>
      {site.icp && (
        <>
          <span class="f-sep">·</span>
          <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">
            {site.icp}
          </a>
        </>
      )}
    </div>
  </div>
</footer>

<style>
  .footer-bg {
    background: var(--t-bg-soft);
    border-top: 1px solid var(--t-line);
    padding-top: 3rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr repeat(2, 1fr);
    gap: 2.6rem;
    padding-bottom: 2.6rem;
  }

  .f-name {
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--t-ink-strong);
    margin-bottom: 0.6rem;
  }
  .f-desc {
    font-size: 1.25rem;
    color: var(--t-ink-mute);
    line-height: 1.75;
    margin: 0 0 1rem;
    max-width: 32rem;
  }
  .f-social { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .f-social-btn {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    color: var(--t-ink-mute);
    background: var(--t-bg-card);
    border: 1px solid var(--t-line);
    border-radius: var(--t-radius-full);
    transition: all 0.25s var(--t-ease);
  }
  .f-social-btn:hover {
    color: var(--sc, var(--t-primary));
    border-color: var(--sc, var(--t-primary));
    transform: translateY(-2px);
  }
  .f-social-icon { display: grid; place-items: center; }
  .f-social-icon :global(svg) {
    width: 1.7rem;
    height: 1.7rem;
    display: block;
  }

  .f-title {
    font-size: 1.32rem;
    font-weight: 700;
    color: var(--t-ink-strong);
    margin-bottom: 0.9rem;
  }
  .f-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .f-list a {
    font-size: 1.25rem;
    color: var(--t-ink-mute);
    transition: color 0.2s;
  }
  .f-list a:hover { color: var(--t-primary); }

  .f-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding-top: 1.4rem;
    padding-bottom: 1.8rem;
    border-top: 1px solid var(--t-line);
    font-size: 1.18rem;
    color: var(--t-ink-mute);
  }
  .f-sep { opacity: 0.5; }

  @media (max-width: 860px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer-inner { grid-template-columns: 1fr; gap: 1.8rem; }
  }
</style>
