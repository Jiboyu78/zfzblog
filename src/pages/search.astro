---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" kind="list">
  <header class="page-head">
    <h1 class="page-title">全文搜索</h1>
    <p class="page-sub">按 <kbd>⌘K</kbd> / <kbd>Ctrl+K</kbd> 随时唤起快捷搜索</p>
  </header>

  <div class="list-wrap">
    <div class="sp-box">
      <div class="sp-input-wrap">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          id="sp-input"
          placeholder="搜索文章标题、标签、正文…"
          autocomplete="off"
          aria-label="搜索"
        />
      </div>
      <div id="sp-results" class="sp-results">
        <p class="sp-hint">输入关键词开始搜索</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-sub kbd {
    font-family: var(--font-mono); font-size: 1.1rem;
    padding: 0.1rem 0.4em; border: 1px solid var(--border);
    border-radius: var(--radius-xs); background: var(--bg-soft);
  }

  .sp-box { border-bottom: 1px solid var(--border); }
  .sp-input-wrap {
    display: flex; align-items: center; gap: 0.7rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--fg-mute);
    transition: border-color 0.25s;
  }
  .sp-input-wrap:focus-within { border-bottom-color: var(--color-primary); }
  .sp-input-wrap input {
    flex: 1; border: none; outline: none; background: transparent;
    color: var(--fg-strong); font-size: 1.5rem; font-family: inherit;
  }
  .sp-results { margin-top: 0.5rem; }
  .sp-hint { color: var(--fg-mute); font-size: 1.35rem; text-align: center; padding: 2.4rem 0; }

  :global(.sp-item) {
    display: block; padding: 1.2rem 0;
    border-bottom: 1px solid var(--border-soft);
    text-decoration: none;
    transition: background 0.25s;
  }
  :global(.sp-item:hover) { background: var(--bg-soft); }
  :global(.sp-item-title) { display: block; font-weight: 700; color: var(--fg-strong); font-size: 1.55rem; margin-bottom: 0.35rem; }
  :global(.sp-item-title mark) { background: color-mix(in srgb, var(--color-accent) 22%, transparent); color: inherit; padding: 0 2px; }
  :global(.sp-item-excerpt) { display: block; font-size: 1.3rem; color: var(--fg-mute); line-height: 1.75; }
  :global(.sp-item-meta) { display: flex; gap: 0.9rem; margin-top: 0.5rem; font-size: 1.15rem; color: var(--fg-mute); }
  :global(.sp-item-tag) { color: var(--color-primary); }
  html.dark :global(.sp-item-tag) { color: #7fb0e0; }
</style>

<script>
  const input = document.getElementById('sp-input') as HTMLInputElement;
  const out = document.getElementById('sp-results')!;
  let pf: any = null;

  async function getPf() {
    if (pf) return pf;
    try {
      const mod = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
      pf = mod.default ?? mod;
      await pf.init?.();
      return pf;
    } catch {
      return null;
    }
  }

  function esc(s: string) {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);
  }

  let timer = 0;
  input?.addEventListener('input', () => {
    clearTimeout(timer);
    const q = input.value.trim();
    if (!q) { out.innerHTML = '<p class="sp-hint">输入关键词开始搜索</p>'; return; }
    timer = window.setTimeout(async () => {
      const p = await getPf();
      if (!p) {
        out.innerHTML = '<p class="sp-hint">搜索索引尚未生成。开发模式下属正常现象，运行 <code>npm run build</code> 后即可使用。</p>';
        return;
      }
      const res = await p.search(q);
      const list = await Promise.all((res.results || []).slice(0, 30).map((r: any) => r.data()));
      if (!list.length) {
        out.innerHTML = `<p class="sp-hint">没有找到「${esc(q)}」相关内容</p>`;
        return;
      }
      out.innerHTML = list.map((r: any) => {
        const title = r.meta?.title || r.excerpt || '';
        const desc = r.meta?.description || '';
        const tags = Array.isArray(r.meta?.tags) ? r.meta.tags : [];
        return `
        <a class="sp-item" href="${r.url}">
          <span class="sp-item-title">${title}</span>
          ${desc ? `<span class="sp-item-excerpt">${esc(desc)}</span>` : ''}
          <span class="sp-item-meta">
            ${r.meta?.category ? `<span class="sp-item-tag">${r.meta.category}</span>` : ''}
            ${r.meta?.date ? `<span>${r.meta.date}</span>` : ''}
            ${tags.slice(0, 3).map((t: string) => `<span class="sp-item-tag">${t}</span>`).join('')}
          </span>
        </a>`;
      }).join('');
    }, 240);
  });

  input?.focus();
</script>
