---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, social, socialIcons, socialKeys, personas } from '@/config';

// src/content/about.md 缺失时静默降级为占位提示
const aboutMods = import.meta.glob('/src/content/about.md', { eager: true });
const AboutContent =
  (aboutMods['/src/content/about.md'] as { Content?: any } | undefined)?.Content ?? null;

const socialList = socialKeys.map((k) => ({ key: k, ...social[k], ...socialIcons[k] }));
---

<BaseLayout title="关于" kind="page">
  <div class="about">
    <!-- 顶部简介大卡：毛玻璃 + 背景图 30% 透明叠加 -->
    <header
      class="hero-card reveal"
      style={`--about-bg:url('${personas.background}')`}
    >
      <img
        class="hc-avatar"
        src={site.avatar}
        alt={`${site.author} 的头像`}
        loading="eager"
      />
      <h1 class="hc-name">{site.author}</h1>
      <p class="hc-bio">{site.bio}</p>
      <div class="hc-socials">
        {
          socialList.map((s) => (
            <a
              href={s.url}
              class="social-logo"
              style={`--sc:${s.color}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              title={s.label}
            >
              <span class="sl-icon" set:html={s.svg} />
            </a>
          ))
        }
      </div>
    </header>

    <!-- 个性标签区 -->
    <section
      class="persona reveal"
      style={`--about-bg:url('${personas.background}')`}
    >
      <div class="persona-inner">
        {
          personas.groups.map((g) => (
            <div class="persona-group">
              <h2 class="persona-title">{g.name}</h2>
              <div class="persona-tags">
                {g.tags.map((t) => <span class="persona-tag">{t}</span>)}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 自我介绍（可替换的 md 内容） -->
    <section class="ab-md reveal">
      {
        AboutContent ? (
          <div class="prose">
            <AboutContent />
          </div>
        ) : (
          <p class="md-placeholder">在 src/content/about.md 里写你的自我介绍</p>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .about { max-width: 950px; margin: 0 auto; padding: 3rem 1.5rem 4rem; }

  /* ============ 顶部简介大卡 ============ */
  .hero-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--t-radius-lg);
    border: 1px solid var(--t-line);
    background: color-mix(in srgb, var(--t-bg-card) 72%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: var(--t-shadow-card);
    padding: 3.2rem 2.4rem 2.8rem;
    margin-bottom: 2.4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.9rem;
  }
  .hero-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: var(--about-bg);
    background-size: cover;
    background-position: center;
    opacity: 0.3;
  }
  .hero-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--t-bg-card) 55%, transparent);
  }

  .hc-avatar {
    width: 9.6rem;
    height: 9.6rem;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--t-primary);
    box-shadow: var(--t-shadow-card);
  }
  .hc-name {
    font-size: 2.6rem;
    margin: 0.4rem 0 0;
    letter-spacing: -0.5px;
    color: var(--t-ink-strong, var(--t-ink));
  }
  .hc-bio {
    font-size: 1.4rem;
    color: var(--t-ink-mute);
    margin: 0 0 0.6rem;
  }

  /* 社交平台圆形 logo 图标（参考首页 IntroHero .social-logo） */
  .hc-socials { display: flex; gap: 1.2rem; justify-content: center; }
  .social-logo {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    color: var(--sc, var(--t-primary));
    background: color-mix(in srgb, var(--t-bg-card) 80%, transparent);
    border: 1px solid var(--t-line);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: all 0.28s var(--t-ease);
  }
  .social-logo:hover {
    color: #fff;
    background: var(--sc, var(--t-primary));
    border-color: transparent;
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 10px 24px -10px color-mix(in srgb, var(--sc, var(--t-primary)) 60%, transparent);
  }
  .sl-icon { display: grid; place-items: center; width: 2rem; height: 2rem; }
  .sl-icon :global(svg) { width: 100%; height: 100%; }

  /* ============ 个性标签区 ============ */
  .persona {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--t-radius-lg);
    border: 1px solid var(--t-line);
    margin-bottom: 2.4rem;
  }
  .persona::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: var(--about-bg);
    background-size: cover;
    background-position: center;
    opacity: 0.18;
  }
  .persona::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--t-bg-card) 72%, transparent);
  }
  .persona-inner {
    padding: 2.4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .persona-title {
    font-size: 1.6rem;
    margin: 0 0 1.1rem;
    color: var(--t-primary);
    font-family: var(--t-font-mono, var(--font-mono));
  }
  .persona-tags { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  .persona-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.4rem;
    font-size: 1.3rem;
    color: var(--t-ink);
    background: color-mix(in srgb, var(--t-bg-card) 55%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--t-line);
    border-radius: var(--t-radius-full);
    transition: all 0.28s var(--t-ease);
  }
  .persona-tag:hover {
    color: var(--t-primary);
    border-color: var(--t-primary);
    transform: translateY(-2px);
  }

  /* ============ md 自我介绍区 ============ */
  .ab-md {
    border-radius: var(--t-radius-lg);
    border: 1px solid var(--t-line);
    background: var(--t-bg-card);
    box-shadow: var(--t-shadow-card);
    padding: 2.4rem;
  }
  .md-placeholder {
    margin: 0;
    color: var(--t-ink-mute);
    font-size: 1.35rem;
    text-align: center;
    font-family: var(--t-font-mono, var(--font-mono));
  }

  @media (max-width: 700px) {
    .hero-card { padding: 2.4rem 1.6rem; }
    .hc-avatar { width: 8rem; height: 8rem; }
    .hc-name { font-size: 2.2rem; }
    .persona-inner { padding: 1.8rem 1.6rem; }
    .ab-md { padding: 1.8rem 1.6rem; }
  }
</style>
