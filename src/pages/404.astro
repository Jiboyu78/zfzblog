---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" kind="page" noIndex>
  <div class="e404">
    <div class="code">
      <span class="digit">4</span>
      <span class="digit err">0</span>
      <span class="digit">4</span>
    </div>
    <h1 class="msg">这条路径不存在</h1>
    <p class="sub">也许页面被移动了，或者你手抖多敲了一个字符。</p>
    <div class="acts">
      <a href="/" class="btn btn-primary">回到首页</a>
      <a href="/blog/" class="btn">浏览文章</a>
      <button class="btn" id="search-404">全文搜索</button>
    </div>
  </div>
</BaseLayout>

<style>
  .e404 { text-align: center; padding: 6rem 1rem; }
  .code {
    display: inline-flex;
    gap: 0.2rem;
    margin-bottom: 1.4rem;
    font-family: var(--font-mono);
    font-size: 7rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-primary);
    letter-spacing: 4px;
  }
  .digit.err { color: var(--color-accent); }
  .msg { font-size: 2.4rem; margin: 0 0 0.6rem; }
  .sub { color: var(--fg-mute); margin: 0 0 1.8rem; font-size: 1.35rem; }
  .acts { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.7em 1.6em;
    border-radius: var(--radius-sm);
    font-size: 1.3rem;
    text-decoration: none;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg-strong);
    cursor: pointer;
    transition: all 0.25s var(--ease-out);
  }
  .btn:hover { color: var(--color-primary); border-color: var(--color-primary); }
  .btn-primary { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .btn-primary:hover { background: var(--color-primary-dark); border-color: var(--color-primary-dark); color: #fff; }
</style>

<script>
  document.getElementById('search-404')?.addEventListener('click', () => {
    document.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', metaKey: true, bubbles: true }));
  });
</script>
